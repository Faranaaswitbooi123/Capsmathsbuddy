"use client";
import { useState, useEffect } from "react";

const DATA:any = {
  8: ["Exponents","Algebraic Expressions","Factorisation","Equations","Geometry","Pythagoras","Area & Volume","Data"],
  9: ["Exponents & Surds","Algebraic Fractions","Factorisation","Equations & Inequalities","Functions","Geometry","Trig Intro","Finance","Stats"],
  10: ["Algebra","Functions & Graphs","Finance","Trig","Euclidean Geometry","Analytical","Stats & Prob"],
  11: ["Exponents","Equations","Functions","Finance","Trig","Euclidean","Analytical","Stats","Prob"],
  12: ["Algebra","Functions","Finance","Trig","Geometry","Analytical","Stats","Calculus","Prob"]
};

const LESSONS:any = {
  "Exponents": { theory: "a^m x a^n = a^(m+n) | a^m / a^n = a^(m-n) | (a^m)^n = a^(mn)", ex: "Simplify: 2^3 x 2^4 = 2^7 = 128", qs: ["Simplify 3^2 x 3^5", "Solve 2^x=32", "Simplify (x^2)^3"] },
  "Algebraic Expressions": { theory: "Collect like terms, Distributive law: a(b+c)=ab+ac", ex: "Simplify 2x+3x=5x", qs: ["Simplify 5a+2a-3a", "Expand 3(x+2)", "Simplify 2x*3x"] },
  "default": { theory: "CAPS aligned lesson. Understand definitions, then practice.", ex: "Example: Worked example will be here with steps.", qs: ["Question 1", "Question 2 with steps", "Past paper style Q3"] }
};

export default function Page(){
  const [grade,setGrade]=useState(10);
  const [topic,setTopic]=useState(DATA[10][0]);
  const [email,setEmail]=useState("");
  const [paid,setPaid]=useState(false);
  const [showAns,setShowAns]=useState(-1);

  useEffect(()=>{
    const p = localStorage.getItem("786_paid");
    if(p) setPaid(true);
    if(window.location.search.includes("success")){ localStorage.setItem("786_paid","yes"); setPaid(true); }
  },[]);

  async function pay(){
    if(!email.includes("@")){alert("Enter your email first");return;}
    const res = await fetch("/api/pay",{method:"POST",body:JSON.stringify({email, grade})});
    const d = await res.json();
    if(d.data?.authorization_url) window.location.href=d.data.authorization_url;
    else alert("Paystack not set yet - add keys in Vercel. But for testing I unlocked you. WhatsApp me.");
  }

  const lesson = (LESSONS as any)[topic] || (LESSONS as any)["default"];

  return(
    <div style={{fontFamily:"sans-serif", maxWidth:900, margin:"0 auto", padding:16, background:"#f8fafc"}}>
      <div style={{background:"#111827", color:"white", padding:20, borderRadius:16}}>
        <h1 style={{margin:0}}>786 CAPS Maths Buddy 📚</h1>
        <p>Gr 8-12 | Whole syllabus | R49 once-off | By you in Uitenhage</p>
        <div style={{display:"flex", gap:8, flexWrap:"wrap"}}>
          {[8,9,10,11,12].map(g=>(
            <button key={g} onClick={()=>{setGrade(g); setTopic(DATA[g][0])}} style={{padding:"8px 16px", borderRadius:20, background: grade==g? "#22c55e":"white", color: grade==g?"white":"black", border:"none", fontWeight:700}}>{g}Gr</button>
          ))}
        </div>
      </div>

      {!paid && (
        <div style={{background:"white", border:"2px solid #22c55e", padding:16, borderRadius:12, marginTop:12}}>
          <h3>🔒 Grade {grade} locked - Unlock for R49</h3>
          <p>One payment = Full year, all grades 8-12. Past papers, memos, lessons.</p>
          <input value={email} onChange={e=>setEmail(e.target.value)} placeholder="Your email for Paystack" style={{width:"100%", padding:12, borderRadius:8, border:"1px solid #ccc", marginBottom:8}}/>
          <button onClick={pay} style={{width:"100%", padding:14, background:"#22c55e", color:"white", border:"none", borderRadius:10, fontWeight:800, fontSize:16}}>Pay R49 with Paystack - Unlock</button>
          <p style={{fontSize:12}}>After pay you return here automatically unlocked. For help: WhatsApp 078... </p>
        </div>
      )}

      <div style={{display:"flex", gap:8, marginTop:16, flexWrap:"wrap"}}>
        {DATA[grade].map((t:string)=>(
          <button key={t} onClick={()=>setTopic(t)} style={{padding:"6px 12px", borderRadius:20, border: topic==t?"2px solid black":"1px solid #ddd", background: topic==t?"black":"white", color: topic==t?"white":"black"}}>{t}</button>
        ))}
      </div>

      <div style={{background:"white", padding:16, borderRadius:12, marginTop:12}}>
        <h2>{grade} - {topic}</h2>
        <p><b>Theory:</b> {lesson.theory}</p>
        <div style={{background:"#fef9c3", padding:12, borderRadius:8}}><b>Example:</b> {lesson.ex}</div>

        <h3>Practice (CAPS Exam style)</h3>
        {lesson.qs.map((q:string,i:number)=>(
          <div key={i} style={{border:"1px solid #eee", padding:10, borderRadius:8, marginBottom:8}}>
            <p><b>Q{i+1}.</b> {q} {paid? "" : "(Unlock to see memo)"}</p>
            {paid && <button onClick={()=>setShowAns(showAns==i?-1:i)} style={{fontSize:12}}>{showAns==i?"Hide memo":"Show memo"}</button>}
            {paid && showAns==i && <p style={{background:"#dcfce7", padding:8}}>Memo: Step 1: Apply law. Step 2: Simplify. Final answer with method. (You can expand with real memos later)</p>}
          </div>
        ))}

        <a href={`https://wa.me/277...?text=Hi I need help with Gr${grade} ${topic}`} target="_blank" style={{display:"block", textAlign:"center", background:"#25D366", color:"white", padding:12, borderRadius:10, marginTop:12, textDecoration:"none", fontWeight:700}}>Ask on WhatsApp for help</a>
      </div>

      <p style={{textAlign:"center", fontSize:12, marginTop:20}}>© 2026 786 Caps Maths Buddy | Made in Uitenhage for SA learners</p>
    </div>
  )
}
